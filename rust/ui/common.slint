// Shared skin contract. Skin components expose these models and the same shared-action callbacks.
export struct ChipData {
    id: string, text: string, initial: string, accent: color,
    ink: color, outline: color, stale: bool, px: float, pw: float, dash-path: string,
    bg-top: color, bg-bottom: color, badge-border: color, badge-ink: color,
    accent-light: color, accent-dark: color, glow: color,
}
export struct LineData {
    label: string, pct: string, eta: string, text: string,
    fill: float, alert: bool, kind: int, py: float, pct-width: float,
    ph: float, stat-tag: string, tag-color: color,
    bar-top: color, bar-bottom: color, track-border: color,
    pct-color: color, label-color: color,
    meter-x: float, meter-w: float, fill-w: float, pct-x: float, eta-x: float,
    ascii-filled: string, ascii-empty: string, bracket-color: color, dot-color: color,
    tag-w: float,
}
export struct CardData {
    id: string, name: string, plan: string, initial: string, accent: color,
    lines: [LineData], py: float, ph: float, px: float, label-width: float, eta-width: float,
    pw: float, bg-top: color, bg-bottom: color, head-bg: color,
    border-color: color, cross-color: color,
    glow-top: color, glow-mid: color, glow-end: color,
    accent-light: color, accent-dark: color,
    badge-ink: color, badge-border: color,
    name-color: color, plan-color: color,
    plan-bg-top: color, plan-bg-bottom: color, plan-border: color,
    plan-w: float, plan-is-badge: bool,
    show-cursor: bool, cursor-indent: float,
}
export struct HeaderButtonData {
    px: float, py: float, pw: float, ph: float,
    label: string, action: string, active: bool,
}
export component SkinWindow inherits Window {
    in property <string> shared-skin: "classic";
    in property <[ChipData]> shared-chips;
    in property <[CardData]> shared-cards;
    in property <[HeaderButtonData]> shared-buttons;
    in property <float> shared-content-width: 640;
    in property <float> shared-content-height: 120;
    in property <bool> shared-docked;
    in property <bool> shared-pinned;
    in property <int> shared-interval: 5;
    in property <string> shared-telemetry-left;
    in property <float> shared-telemetry-left-w;
    in property <string> shared-telemetry-center;
    in property <float> shared-telemetry-center-w;
    in property <color> shared-telemetry-color;
    in-out property <string> shared-render-key;
    callback shared-action(string);
    callback shared-drag(float, float, int);
    no-frame: true;
    always-on-top: true;
    default-font-family: "Segoe UI";
    default-font-size: 11px;
    width: shared-content-width * 1px;
    height: shared-content-height * 1px;
}
